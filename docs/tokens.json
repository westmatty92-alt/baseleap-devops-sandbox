        "hex": "#22c55e"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.62,
          0.043
        ],
        "hex": "#f59e0b"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.937,
          0.267,
          0.267
