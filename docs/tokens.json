{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Brand contract for Baseleap tools, built strictly from BASELEAP Brand Book v2 and the Brand Color System v1. Dark first; Volt is the one accent. No off-palette colours.",
  "color": {
    "$type": "color",
    "midnight": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.051,
          0.122,
          0.176
        ],
        "hex": "#0d1f2d"
      }
    },
    "volt": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.831,
          0.627
        ],
        "hex": "#00d4a0"
      }
    },
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.961,
          0.941
        ],
        "hex": "#f4f5f0"
      }
    },
    "depth": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.18
        ],
        "hex": "#1a1a2e"
      }
    },
    "run": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.659,
          0.471
        ],
        "hex": "#00a878"
      }
