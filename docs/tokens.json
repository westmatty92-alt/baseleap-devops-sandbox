      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.18
        ],
        "hex": "#1a1a2e"
      }
    },
    "border-on-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.18
