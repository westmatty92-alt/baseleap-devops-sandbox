# Copy to .env.local (git-ignored). Never commit real values.
# Baseleap ledger (the Console database). Deliberately NOT named SUPABASE_*: the app you're
# building has its own Supabase, and its keys use those names. Mixing them up would point
# the app at the Console, or the ledger at the app.
BASELEAP_LEDGER_URL=https://qqgdzwkbuzciocnyimje.supabase.co
BASELEAP_LEDGER_SERVICE_KEY=
BASELEAP_LEDGER_ANON_KEY=
BASELEAP_OPERATOR_ID=
BASELEAP_OPERATOR_EMAIL=

# ---- The app (names from docs/architecture.md "Environment variables"; values set by Matthew) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used only by src/lib/server/admin.ts (and CI e2e setup). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=
SESSION_MAX_AGE_DAYS=30
# Set by Vercel; used by GET /api/health `version`.
VERCEL_GIT_COMMIT_SHA=

# ---- Database scripts (npm run gen:types / db:migrate / db:test) ----
# Postgres URL of the Supabase preview branch (or a throwaway local Postgres). Never production.
SUPABASE_PREVIEW_DB_URL=
# Production project ref. db scripts refuse a URL containing it, and refuse any non-local URL
# while it is unset.
SUPABASE_PROD_PROJECT_REF=

# ---- E2E (CI only, decision 0004) ----
E2E_OWNER_EMAIL=
E2E_TECH_A_EMAIL=
E2E_TECH_B_EMAIL=
